{
  "name": "codex-powertoys-vscode",
  "displayName": "Codex PowerToys",
  "description": "Inspect and safely manage Codex skills, plugins, agents, and MCP configuration.",
  "version": "1.0.3",
  "publisher": "onepersonlabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OnePersonLabs/codex-powertoys"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Chat",
    "AI",
    "Other"
  ],
  "icon": "resources/codex-powertoys-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "test": "tsx --test test/**/*.test.ts",
    "vscode:prepublish": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "package": "pnpm build && npx @vscode/vsce package"
  },
  "devDependencies": {
    "@codex-powertoys/core": "workspace:*",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.25.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.3"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexPowerToys",
          "title": "Codex PowerToys",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        }
      ]
    },
    "views": {
      "codexPowerToys": [
        {
          "id": "codexPowerToys.resources",
          "name": "Resources",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        },
        {
          "id": "codexPowerToys.plugins",
          "name": "Plugins",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        },
        {
          "id": "codexPowerToys.mcps",
          "name": "MCPs",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        },
        {
          "id": "codexPowerToys.skills",
          "name": "Skills",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        },
        {
          "id": "codexPowerToys.agents",
          "name": "Agents",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        },
        {
          "id": "codexPowerToys.info",
          "name": "Info",
          "type": "webview",
          "icon": "resources/codex-powertoys-icon-activity-bar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codexPowerToys.refresh",
        "title": "Refresh Codex PowerToys",
        "icon": "$(refresh)"
      },
      {
        "command": "codexPowerToys.skills.toggleSupporting",
        "title": "Show or Hide Supporting Skill Files",
        "icon": "$(eye)"
      },
      {
        "command": "codexPowerToys.skills.filter",
        "title": "Filter Skills",
        "icon": "$(filter)"
      },
      {
        "command": "codexPowerToys.plugins.filter",
        "title": "Filter Plugins",
        "icon": "$(filter)"
      },
      {
        "command": "codexPowerToys.resources.filter",
        "title": "Filter Resources",
        "icon": "$(filter)"
      },
      {
        "command": "codexPowerToys.resources.clearFilter",
        "title": "Clear Resource Filter",
        "icon": "$(close)"
      },
      {
        "command": "codexPowerToys.skills.clearFilter",
        "title": "Clear Skill Filter",
        "icon": "$(close)"
      },
      {
        "command": "codexPowerToys.plugins.clearFilter",
        "title": "Clear Plugin Filter",
        "icon": "$(close)"
      },
      {
        "command": "codexPowerToys.mcp.filter",
        "title": "Filter MCPs",
        "icon": "$(filter)"
      },
      {
        "command": "codexPowerToys.mcp.clearFilter",
        "title": "Clear MCP Filter",
        "icon": "$(close)"
      },
      {
        "command": "codexPowerToys.resources.toggleSuperseded",
        "title": "Toggle Superseded Resources",
        "icon": "$(eye)"
      },
      {
        "command": "codexPowerToys.plugins.toggleSuperseded",
        "title": "Toggle Superseded Plugins",
        "icon": "$(eye)"
      },
      {
        "command": "codexPowerToys.skills.toggleSuperseded",
        "title": "Toggle Superseded Skills",
        "icon": "$(eye)"
      },
      {
        "command": "codexPowerToys.mcp.toggleSuperseded",
        "title": "Toggle Superseded MCPs",
        "icon": "$(eye)"
      },
      {
        "command": "codexPowerToys.resources.collapseAll",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "codexPowerToys.resources.expandAll",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "codexPowerToys.startSkillCreator",
        "title": "Start Skill Creator Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codexPowerToys.refreshAgents",
        "title": "Refresh Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "codexPowerToys.mcp.add",
        "title": "Add MCP",
        "icon": "$(add)"
      },
      {
        "command": "codexPowerToys.mcp.edit",
        "title": "Edit MCP",
        "icon": "$(edit)"
      },
      {
        "command": "codexPowerToys.mcp.delete",
        "title": "Delete MCP",
        "icon": "$(trash)"
      },
      {
        "command": "codexPowerToys.mcp.loadTools",
        "title": "Load MCP Tools",
        "icon": "$(plug)"
      },
      {
        "command": "codexPowerToys.info.toggleExpand",
        "title": "Expand or Collapse All Info",
        "icon": "$(collapse-all)"
      },
      {
        "command": "codexPowerToys.resource.cut",
        "title": "Cut Resource",
        "icon": "$(cut)"
      },
      {
        "command": "codexPowerToys.resource.copy",
        "title": "Copy Resource",
        "icon": "$(copy)"
      },
      {
        "command": "codexPowerToys.resource.copyFullPath",
        "title": "Copy Full Path",
        "icon": "$(copy)"
      },
      {
        "command": "codexPowerToys.resource.copyRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "codexPowerToys.resource.paste",
        "title": "Paste Resource",
        "icon": "$(clippy)"
      },
      {
        "command": "codexPowerToys.resource.rename",
        "title": "Rename Resource",
        "icon": "$(edit)"
      },
      {
        "command": "codexPowerToys.resource.delete",
        "title": "Delete Resource",
        "icon": "$(trash)"
      },
      {
        "command": "codexPowerToys.plugin.enable",
        "title": "Enable Plugin",
        "icon": "$(play)",
        "enablement": "!resourceEnabled"
      },
      {
        "command": "codexPowerToys.plugin.disable",
        "title": "Disable Plugin",
        "icon": "$(debug-pause)",
        "enablement": "resourceEnabled"
      },
      {
        "command": "codexPowerToys.plugin.reset",
        "title": "Reset Plugin Override",
        "icon": "$(discard)"
      },
      {
        "command": "codexPowerToys.plugin.openManifest",
        "title": "Open Plugin Manifest",
        "icon": "$(file-code)"
      },
      {
        "command": "codexPowerToys.plugin.openDirectory",
        "title": "Open Plugin Directory",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codexPowerToys.mcp.enableGlobal",
        "title": "Enable MCP Globally",
        "enablement": "!resourceEnabled"
      },
      {
        "command": "codexPowerToys.mcp.disableGlobal",
        "title": "Disable MCP Globally",
        "enablement": "resourceEnabled"
      },
      {
        "command": "codexPowerToys.mcp.enableLocal",
        "title": "Enable MCP Locally",
        "enablement": "!resourceEnabled"
      },
      {
        "command": "codexPowerToys.mcp.disableLocal",
        "title": "Disable MCP Locally",
        "enablement": "resourceEnabled"
      },
      {
        "command": "codexPowerToys.skill.enableGlobal",
        "title": "Enable Skill Globally",
        "icon": "$(play)",
        "enablement": "!resourceEnabled"
      },
      {
        "command": "codexPowerToys.skill.disableGlobal",
        "title": "Disable Skill Globally",
        "icon": "$(debug-pause)",
        "enablement": "resourceEnabled"
      },
      {
        "command": "codexPowerToys.skill.resetGlobal",
        "title": "Reset Global Skill Override",
        "icon": "$(discard)"
      },
      {
        "command": "codexPowerToys.skill.enableLocal",
        "title": "Enable Skill Locally",
        "icon": "$(play)",
        "enablement": "!resourceEnabled"
      },
      {
        "command": "codexPowerToys.skill.disableLocal",
        "title": "Disable Skill Locally",
        "icon": "$(debug-pause)",
        "enablement": "resourceEnabled"
      },
      {
        "command": "codexPowerToys.skill.resetLocal",
        "title": "Reset Local Skill Override",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexPowerToys.refresh",
          "when": "view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.resources.collapseAll",
          "when": "view == codexPowerToys.resources && codexPowerToys.resourcesTreeExpanded",
          "group": "navigation@1"
        },
        {
          "command": "codexPowerToys.resources.expandAll",
          "when": "view == codexPowerToys.resources && !codexPowerToys.resourcesTreeExpanded",
          "group": "navigation@1"
        },
        {
          "command": "codexPowerToys.skills.toggleSupporting",
          "when": "view == codexPowerToys.resources",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.resources.filter",
          "when": "view == codexPowerToys.resources",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.resources.clearFilter",
          "when": "view == codexPowerToys.resources && codexPowerToys.resourcesFilterActive",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.resources.toggleSuperseded",
          "when": "view == codexPowerToys.resources",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.skills.filter",
          "when": "view == codexPowerToys.skills",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.plugins.filter",
          "when": "view == codexPowerToys.plugins",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.plugins.clearFilter",
          "when": "view == codexPowerToys.plugins && codexPowerToys.pluginsFilterActive",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.plugins.toggleSuperseded",
          "when": "view == codexPowerToys.plugins",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.skills.clearFilter",
          "when": "view == codexPowerToys.skills && codexPowerToys.skillsFilterActive",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.skills.toggleSuperseded",
          "when": "view == codexPowerToys.skills",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.mcp.filter",
          "when": "view == codexPowerToys.mcps",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.mcp.clearFilter",
          "when": "view == codexPowerToys.mcps && codexPowerToys.mcpsFilterActive",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.mcp.toggleSuperseded",
          "when": "view == codexPowerToys.mcps",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.startSkillCreator",
          "when": "view == codexPowerToys.resources",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.mcp.add",
          "when": "view == codexPowerToys.resources || view == codexPowerToys.mcps",
          "group": "navigation"
        },
        {
          "command": "codexPowerToys.info.toggleExpand",
          "when": "view == codexPowerToys.info",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codexPowerToys.resource.cut",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents) && viewItem != codexRoot && viewItem != codexPlugin && viewItem != codexResourceGroup && viewItem != codexMcpTool"
        },
        {
          "command": "codexPowerToys.resource.copy",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents) && viewItem != codexMcpTool"
        },
        {
          "command": "codexPowerToys.resource.copyFullPath",
          "when": "view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents"
        },
        {
          "command": "codexPowerToys.resource.copyRelativePath",
          "when": "view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents"
        },
        {
          "command": "codexPowerToys.resource.paste",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills || view == codexPowerToys.mcps || view == codexPowerToys.agents) && viewItem != codexMcpTool"
        },
        {
          "command": "codexPowerToys.resource.rename",
          "when": "viewItem == codexSkill || viewItem == codexPluginSkill || viewItem == codexMcp || viewItem == codexPluginMcp || viewItem == codexAgent"
        },
        {
          "command": "codexPowerToys.resource.delete",
          "when": "viewItem == codexSkill || viewItem == codexPluginSkill || viewItem == codexMcp || viewItem == codexPluginMcp || viewItem == codexAgent || viewItem == codexAgentDir"
        },
        {
          "command": "codexPowerToys.mcp.edit",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp)"
        },
        {
          "command": "codexPowerToys.mcp.delete",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp)"
        },
        {
          "command": "codexPowerToys.mcp.loadTools",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp)"
        },
        {
          "command": "codexPowerToys.mcp.enableGlobal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp) && resourceScope == global"
        },
        {
          "command": "codexPowerToys.mcp.disableGlobal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp) && resourceScope == global"
        },
        {
          "command": "codexPowerToys.mcp.enableLocal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp) && resourceScope == workspace"
        },
        {
          "command": "codexPowerToys.mcp.disableLocal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.mcps) && (viewItem == codexMcp || viewItem == codexPluginMcp) && resourceScope == workspace"
        },
        {
          "command": "codexPowerToys.plugin.enable",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins) && viewItem == codexPlugin"
        },
        {
          "command": "codexPowerToys.plugin.disable",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins) && viewItem == codexPlugin"
        },
        {
          "command": "codexPowerToys.plugin.reset",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins) && viewItem == codexPlugin"
        },
        {
          "command": "codexPowerToys.plugin.openManifest",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins) && viewItem == codexPlugin"
        },
        {
          "command": "codexPowerToys.plugin.openDirectory",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins) && viewItem == codexPlugin"
        },
        {
          "command": "codexPowerToys.skill.enableGlobal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == global"
        },
        {
          "command": "codexPowerToys.skill.disableGlobal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == global"
        },
        {
          "command": "codexPowerToys.skill.resetGlobal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == global"
        },
        {
          "command": "codexPowerToys.skill.enableLocal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == workspace"
        },
        {
          "command": "codexPowerToys.skill.disableLocal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == workspace"
        },
        {
          "command": "codexPowerToys.skill.resetLocal",
          "when": "(view == codexPowerToys.resources || view == codexPowerToys.plugins || view == codexPowerToys.skills) && (viewItem == codexSkill || viewItem == codexPluginSkill) && resourceScope == workspace"
        }
      ]
    }
  }
}
